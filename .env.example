# Valores de DESENVOLVIMENTO LOCAL. Nenhum segredo real.
# Copie para .env se quiser mudar portas: cp .env.example .env

# --- portas expostas pelo docker compose ---
POSTGRES_PORT=5432
LOCALSTACK_PORT=4566
KEYCLOAK_PORT=8081

# --- PostgreSQL ---
# aplicação (papel sem DDL e sem UPDATE/DELETE no ledger)
DATABASE_URL=postgres://wallet_app:wallet_app@localhost:5432/wallet?sslmode=disable
# migrations (papel dono do schema)
MIGRATE_DATABASE_URL=postgres://wallet_owner:wallet_owner@localhost:5432/wallet?sslmode=disable

# --- testes de integração ---
# superusuário: cria um banco descartável por teste
TEST_PG_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# --- SQS (LocalStack) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_INPUT_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo

# --- OIDC (Keycloak) ---
OIDC_ISSUER=http://localhost:8081/realms/wallet
OIDC_AUDIENCE=wallet-api
# clientes de teste (client_credentials)
PROVIDER_A_CLIENT_ID=provider-a
PROVIDER_A_CLIENT_SECRET=provider-a-secret
PROVIDER_B_CLIENT_ID=provider-b
PROVIDER_B_CLIENT_SECRET=provider-b-secret
WALLET_SERVICE_CLIENT_ID=wallet-service
WALLET_SERVICE_CLIENT_SECRET=wallet-service-secret
