# Valores de DESENVOLVIMENTO LOCAL. Nenhum segredo real.
#
#   cp .env.example .env
#
# O docker compose lê só as portas abaixo (as variáveis da API no compose
# estão no docker-compose.yml). Para rodar a API fora do Docker:
#
#   set -a; . ./.env; set +a; go run ./cmd/server

# --- portas expostas pelo docker compose ---
POSTGRES_PORT=5432
LOCALSTACK_PORT=4566
KEYCLOAK_PORT=8081
APP_PORT=8080
JAEGER_UI_PORT=16686
OTLP_HTTP_PORT=4318

# --- API ---
HTTP_ADDR=:8080
INSTANCE_ID=local-1
LOG_LEVEL=info

# --- PostgreSQL ---
# aplicação (papel sem DDL e sem UPDATE/DELETE no ledger)
DATABASE_URL=postgres://wallet_app:wallet_app@localhost:5432/wallet?sslmode=disable
# migrations: go run ./cmd/migrate up (papel dono do schema)
MIGRATE_DATABASE_URL=postgres://wallet_owner:wallet_owner@localhost:5432/wallet?sslmode=disable

# --- OIDC (Keycloak) ---
OIDC_ISSUER=http://localhost:8081/realms/wallet
OIDC_AUDIENCE=wallet-api
# opcional: onde buscar as chaves públicas, se diferente do emissor
# OIDC_JWKS_URL=http://keycloak:8080/realms/wallet/protocol/openid-connect/certs

# --- SQS (LocalStack) ---
# Na AWS: sem SQS_ENDPOINT e sem chaves fixas (papel IAM da tarefa).
SQS_ENABLED=true
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566
SQS_ACCESS_KEY_ID=test
SQS_SECRET_ACCESS_KEY=test
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_INPUT_DLQ=wager-transactions-dlq.fifo
SQS_ALLOWED_PROVIDERS=provider-a,provider-b

# --- publicador da outbox e worker de referências ---
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_QUEUE=wallet-events.fifo
REFERENCE_WORKER_ENABLED=true

# --- tracing (OpenTelemetry -> Jaeger do compose) ---
TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- testes de integração ---
# superusuário: cria um banco descartável por teste
TEST_PG_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
TEST_SQS_ENDPOINT=http://localhost:4566

# --- clientes de teste do Keycloak (client_credentials) ---
# Não são lidos pela API: servem para pedir tokens nos exemplos do README.
PROVIDER_A_CLIENT_ID=provider-a
PROVIDER_A_CLIENT_SECRET=provider-a-secret
PROVIDER_B_CLIENT_ID=provider-b
PROVIDER_B_CLIENT_SECRET=provider-b-secret
WALLET_SERVICE_CLIENT_ID=wallet-service
WALLET_SERVICE_CLIENT_SECRET=wallet-service-secret
