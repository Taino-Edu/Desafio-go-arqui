{
  "realm": "wallet",
  "enabled": true,
  "accessTokenLifespan": 300,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "provider",
        "description": "Provedor de jogos: envia e consulta as próprias transações"
      },
      {
        "name": "wallet-admin",
        "description": "Serviço interno: carteiras, ledger e reconciliação"
      }
    ]
  },
  "clients": [
    {
      "clientId": "provider-a",
      "name": "Provedor A (teste)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "provider-a-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "provider_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience wallet-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "wallet-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "name": "Provedor B (teste)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "provider-b-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "provider_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience wallet-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "wallet-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "wallet-service",
      "name": "Serviço interno de carteiras",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "wallet-service-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "audience wallet-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "wallet-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "test-provider-a-short-lived",
      "name": "TESTE: provider-a com token de 1 segundo",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "test-short-lived-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "provider_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience wallet-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "wallet-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "access.token.lifespan": "1"
      }
    },
    {
      "clientId": "test-other-audience",
      "name": "TESTE: provider-a sem a audiência wallet-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "test-other-audience-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "provider_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-provider-a",
      "enabled": true,
      "serviceAccountClientId": "provider-a",
      "realmRoles": [
        "provider"
      ]
    },
    {
      "username": "service-account-provider-b",
      "enabled": true,
      "serviceAccountClientId": "provider-b",
      "realmRoles": [
        "provider"
      ]
    },
    {
      "username": "service-account-wallet-service",
      "enabled": true,
      "serviceAccountClientId": "wallet-service",
      "realmRoles": [
        "wallet-admin"
      ]
    },
    {
      "username": "service-account-test-provider-a-short-lived",
      "enabled": true,
      "serviceAccountClientId": "test-provider-a-short-lived",
      "realmRoles": [
        "provider"
      ]
    },
    {
      "username": "service-account-test-other-audience",
      "enabled": true,
      "serviceAccountClientId": "test-other-audience",
      "realmRoles": [
        "provider"
      ]
    }
  ]
}
